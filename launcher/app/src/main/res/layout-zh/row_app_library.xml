<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingTop="8dp" android:paddingBottom="8dp" android:clipChildren="false" android:clipToPadding="false">
    <TextView android:id="@+id/btnLibrary"
        android:layout_width="180dp" android:layout_height="101dp" android:layout_gravity="center_horizontal|top"
        android:gravity="center" android:text="+" android:textSize="44sp" android:textColor="#E8FFFFFF"
        android:background="@drawable/add_app_card" android:focusable="true" android:clickable="true"
        android:contentDescription="@string/add_app" />
    <TextView android:id="@+id/name" android:layout_width="180dp" android:layout_height="22dp"
        android:layout_gravity="center_horizontal|top" android:layout_marginTop="108dp"
        android:text="@string/add_app" android:gravity="center" android:textColor="#CCFFFFFF"
        android:textSize="14sp" android:fontFamily="@string/font_medium" />
</FrameLayout>
