+++ b/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/utils/AppDownloadSpeed.java
@@ -0,0 +1,14 @@
+package com.liskovsoft.smartyoutubetv2.common.utils;
+
+import android.net.TrafficStats;
+import android.os.Process;
+import android.os.SystemClock;
+
+/** Own-UID received traffic, including video, audio, thumbnails and request overhead. */
+public final class AppDownloadSpeed {
+    private final DownloadRate rate = new DownloadRate();
+    public void reset() { rate.reset(); }
+    public double sample() {
+        return rate.sample(TrafficStats.getUidRxBytes(Process.myUid()), SystemClock.elapsedRealtime());
+    }
+}
diff --git a/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/tv/ui/playback/PlaybackNetworkStatus.java b/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/tv/ui/playback/PlaybackNetworkStatus.java
new file mode 100644
--- /dev/null
+++ b/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/tv/ui/playback/PlaybackNetworkStatus.java
@@ -0,0 +1,110 @@
+package com.liskovsoft.smartyoutubetv2.tv.ui.playback;
+
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.os.SystemClock;
+import android.util.Log;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+
+import com.google.android.exoplayer2.Format;
+import com.google.android.exoplayer2.Player;
+import com.google.android.exoplayer2.SimpleExoPlayer;
+import com.liskovsoft.smartyoutubetv2.common.utils.AppDownloadSpeed;
+import com.liskovsoft.smartyoutubetv2.common.utils.DownloadRate;
+import com.liskovsoft.smartyoutubetv2.tv.R;
+import java.util.Locale;
+
+/** Non-focusable loading status. Never reads URLs, account identifiers or VPN configuration. */
+final class PlaybackNetworkStatus implements Runnable, Player.EventListener {
+    private final ViewGroup root;
+    private final View spinner;
+    private final SimpleExoPlayer player;
+    private final TextView label;
+    private final AppDownloadSpeed speed = new AppDownloadSpeed();
+    private boolean running;
+    private double lastRate = Double.NaN;
+    private long lastLogMs;
+
+    PlaybackNetworkStatus(ViewGroup root, View spinner, SimpleExoPlayer player) {
+        this.root = root;
+        this.spinner = spinner;
+        this.player = player;
+        label = new TextView(root.getContext());
+        label.setTextColor(Color.WHITE);
+        label.setTextSize(16);
+        label.setGravity(Gravity.CENTER);
+        label.setFocusable(false);
+        label.setClickable(false);
+        label.setPadding(dp(16), dp(8), dp(16), dp(8));
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(0xD922252B);
+        bg.setCornerRadius(dp(8));
+        label.setBackground(bg);
+        label.setVisibility(View.GONE);
+        FrameLayout.LayoutParams params = new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER);
+        root.addView(label, params);
+        label.setTranslationY(dp(80));
+    }
+
+    private int dp(int value) { return Math.round(value * root.getResources().getDisplayMetrics().density); }
+
+    void start() {
+        if (running) return;
+        running = true;
+        speed.reset();
+        lastRate = Double.NaN;
+        player.addListener(this);
+        run();
+    }
+
+    void stop() {
+        running = false;
+        root.removeCallbacks(this);
+        player.removeListener(this);
+        label.setVisibility(View.GONE);
+    }
+
+    void destroy() {
+        stop();
+        root.removeView(label);
+    }
+
+    @Override public void onPlayerStateChanged(boolean playWhenReady, int playbackState) { updateLabel(); }
+
+    private long bufferMs() { return Math.max(0, player.getTotalBufferedDuration()); }
+
+    private void updateLabel() {
+        boolean buffering = player.getPlaybackState() == Player.STATE_BUFFERING;
+        boolean waiting = player.getPlaybackState() == Player.STATE_IDLE && spinner != null && spinner.isShown();
+        if (!running || !(buffering || waiting)) {
+            label.setVisibility(View.GONE);
+            return;
+        }
+        String rate = Double.isNaN(lastRate) ? root.getContext().getString(R.string.local_speed_waiting) : DownloadRate.format(lastRate);
+        label.setText(root.getContext().getString(R.string.local_loading_network, rate, bufferMs() / 1000.0));
+        label.setVisibility(View.VISIBLE);
+    }
+
+    @Override public void run() {
+        if (!running) return;
+        lastRate = speed.sample();
+        updateLabel();
+        long now = SystemClock.elapsedRealtime();
+        if (now - lastLogMs >= 5000) {
+            lastLogMs = now;
+            Format format = player.getVideoFormat();
+            // Local diagnostics only: deliberately excludes titles, video IDs, URLs and account data.
+            Log.i("PlaybackNetwork", String.format(Locale.ROOT,
+                    "state=%d play=%s rx_Bps=%.0f buffer_ms=%d position_ms=%d quality=%dx%d fps=%.0f bitrate=%d",
+                    player.getPlaybackState(), player.getPlayWhenReady(), lastRate, bufferMs(), player.getCurrentPosition(),
+                    format == null ? 0 : format.width, format == null ? 0 : format.height,
+                    format == null ? 0 : format.frameRate, format == null ? 0 : format.bitrate));
+        }
+        root.postDelayed(this, 1000);
+    }
+}
diff --git a/local-tests/DownloadRateTest.java b/local-tests/DownloadRateTest.java
new file mode 100644
--- /dev/null
+++ b/local-tests/DownloadRateTest.java
@@ -0,0 +1,25 @@
+import com.liskovsoft.smartyoutubetv2.common.utils.DownloadRate;
+public final class DownloadRateTest {
+    private static int count;
+    private static void check(boolean pass) { if (!pass) throw new AssertionError("Case " + (count + 1)); count++; }
+    public static void main(String[] args) {
+        DownloadRate rate = new DownloadRate();
+        check(Double.isNaN(rate.sample(100, 1000)));
+        check(rate.sample(1124, 2000) == 1024);
+        check(rate.sample(3172, 4000) == 1024);
+        check(rate.sample(3172, 5000) == 0);
+        check(Double.isNaN(rate.sample(10, 6000)));
+        check(Double.isNaN(rate.sample(-1, 7000)));
+        check(Double.isNaN(rate.sample(10, 8000)));
+        check(Double.isNaN(rate.sample(20, 8000)));
+        check(Double.isNaN(rate.sample(30, 14000)));
+        rate.reset();
+        check(Double.isNaN(rate.sample(40, 15000)));
+        check(DownloadRate.format(1024).equals("1.0 KB/s"));
+        check(DownloadRate.format(1048576).equals("1.00 MB/s"));
+        check(DownloadRate.format(0).equals("0.0 KB/s"));
+        check(DownloadRate.format(Double.NaN).equals("—"));
+        check(DownloadRate.format(Double.POSITIVE_INFINITY).equals("—"));
+        System.out.println("DownloadRate: " + count + " cases passed");
+    }
+}
