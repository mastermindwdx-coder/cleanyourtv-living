diff --git a/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/utils/DownloadRate.java b/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/utils/DownloadRate.java
new file mode 100644
--- /dev/null
+++ b/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/utils/DownloadRate.java
@@ -0,0 +1,35 @@
+package com.liskovsoft.smartyoutubetv2.common.utils;
+
+import java.util.Locale;
+
+/** Measures byte-counter deltas. No bandwidth estimates and no network requests. */
+public final class DownloadRate {
+    private long previousBytes = -1;
+    private long previousTimeMs = -1;
+
+    public void reset() {
+        previousBytes = -1;
+        previousTimeMs = -1;
+    }
+
+    public double sample(long receivedBytes, long elapsedRealtimeMs) {
+        if (receivedBytes < 0 || elapsedRealtimeMs < 0) {
+            reset();
+            return Double.NaN;
+        }
+        long deltaMs = elapsedRealtimeMs - previousTimeMs;
+        double rate = Double.NaN;
+        if (previousBytes >= 0 && receivedBytes >= previousBytes && deltaMs > 0 && deltaMs <= 5000) {
+            rate = (receivedBytes - previousBytes) * 1000.0 / deltaMs;
+        }
+        previousBytes = receivedBytes;
+        previousTimeMs = elapsedRealtimeMs;
+        return rate;
+    }
+
+    public static String format(double bytesPerSecond) {
+        if (Double.isNaN(bytesPerSecond) || Double.isInfinite(bytesPerSecond) || bytesPerSecond < 0) return "—";
+        if (bytesPerSecond >= 1024 * 1024) return String.format(Locale.ROOT, "%.2f MB/s", bytesPerSecond / (1024 * 1024));
+        return String.format(Locale.ROOT, "%.1f KB/s", bytesPerSecond / 1024);
+    }
+}
diff --git a/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/utils/AppDownloadSpeed.java b/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/utils/AppDownloadSpeed.java
