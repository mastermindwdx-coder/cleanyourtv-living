diff --git a/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/utils/ChinesePlaybackErrors.java b/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/utils/ChinesePlaybackErrors.java
new file mode 100644
--- /dev/null
+++ b/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/utils/ChinesePlaybackErrors.java
@@ -0,0 +1,49 @@
+package com.liskovsoft.smartyoutubetv2.common.utils;
+
+import java.net.ConnectException;
+import java.net.SocketTimeoutException;
+import java.net.UnknownHostException;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.Locale;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** User-facing translation only. The original exception still drives recovery and logging. */
+public final class ChinesePlaybackErrors {
+    private static final Pattern HTTP = Pattern.compile(
+            "(?:Response code\\s*:|HTTP(?:/\\d(?:\\.\\d)?)?\\s+|status(?: code)?\\s*[:=])\\s*([45]\\d{2})\\b",
+            Pattern.CASE_INSENSITIVE);
+
+    private ChinesePlaybackErrors() { }
+
+    public static boolean enabled(Locale locale) {
+        return locale != null && "zh".equals(locale.getLanguage());
+    }
+
+    public static String format(Throwable error, String fallback, Locale locale) {
+        if (!enabled(locale)) return fallback;
+        Set<Throwable> seen = Collections.newSetFromMap(new IdentityHashMap<Throwable, Boolean>());
+        String network = null;
+        for (Throwable cause = error; cause != null && seen.add(cause); cause = cause.getCause()) {
+            Matcher match = HTTP.matcher(String.valueOf(cause.getMessage()));
+            if (match.find()) {
+                int code = Integer.parseInt(match.group(1));
+                switch (code) {
+                    case 403: return "无法加载视频，服务器拒绝了请求（403）。请重新打开视频；若仍失败，请切换网络节点后重试。";
+                    case 404: return "未找到播放资源（404）。请重新打开视频。";
+                    case 410: return "播放资源已失效（410）。请重新打开视频。";
+                    case 429: return "请求过于频繁（429），请稍后重试。";
+                    default: return code >= 500 ? "视频服务暂时不可用（" + code + "），请稍后重试。"
+                            : "播放请求失败（" + code + "）。请重新打开视频。";
+                }
+            }
+            if (cause instanceof SocketTimeoutException) network = "加载视频超时，请检查网络或切换节点后重试。";
+            else if (cause instanceof UnknownHostException) network = "无法解析视频服务器地址，请检查网络和 DNS 设置。";
+            else if (cause instanceof ConnectException) network = "无法连接视频服务器，请检查网络连接。";
+            else if (cause instanceof javax.net.ssl.SSLException) network = "无法建立安全连接，请检查电视的日期、时间和网络。";
+        }
+        return network != null ? network : fallback;
+    }
+}
