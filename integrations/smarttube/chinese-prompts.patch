diff --git a/local-tests/ChinesePlaybackErrorsTest.java b/local-tests/ChinesePlaybackErrorsTest.java
new file mode 100644
--- /dev/null
+++ b/local-tests/ChinesePlaybackErrorsTest.java
@@ -0,0 +1,30 @@
+import com.liskovsoft.smartyoutubetv2.common.utils.ChinesePlaybackErrors;
+import java.net.SocketTimeoutException;
+import java.net.UnknownHostException;
+import java.util.Locale;
+
+public class ChinesePlaybackErrorsTest {
+    private static int count;
+    private static void check(boolean value) {
+        count++;
+        if (!value) throw new AssertionError("Case " + count);
+    }
+    public static void main(String[] args) {
+        Throwable wrapped = new RuntimeException("Source error", new Exception("Response code: 403"));
+        String msg = ChinesePlaybackErrors.format(wrapped, "无法播放", Locale.SIMPLIFIED_CHINESE);
+        check(msg.contains("服务器拒绝") && msg.contains("403") && !msg.contains("Source error"));
+        check(ChinesePlaybackErrors.format(new Exception("HTTP 429"), "fallback", Locale.CHINESE).contains("稍后重试"));
+        check(ChinesePlaybackErrors.format(new Exception("status code: 503"), "fallback", Locale.CHINESE).contains("503"));
+        check(ChinesePlaybackErrors.format(new RuntimeException(new SocketTimeoutException()), "fallback", Locale.CHINESE).contains("超时"));
+        check(ChinesePlaybackErrors.format(new UnknownHostException("private-host.example"), "fallback", Locale.CHINESE).contains("DNS"));
+        check(!ChinesePlaybackErrors.format(new UnknownHostException("private-host.example"), "fallback", Locale.CHINESE).contains("private-host"));
+        check(ChinesePlaybackErrors.format(new Exception("video 403 frames"), "fallback", Locale.CHINESE).equals("fallback"));
+        check(ChinesePlaybackErrors.format(wrapped, "Source error", Locale.US).equals("Source error"));
+        check(ChinesePlaybackErrors.format(null, "无法播放", Locale.CHINESE).equals("无法播放"));
+        Throwable a = new Exception("one");
+        Throwable b = new Exception("two", a);
+        a.initCause(b);
+        check(ChinesePlaybackErrors.format(a, "fallback", Locale.CHINESE).equals("fallback"));
+        System.out.println(count + " checks passed");
+    }
+}
